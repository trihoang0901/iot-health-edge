# Sao chep tep nay thanh .env va dien gia tri cuc bo. Khong commit .env.

# Edge service: tai khoan chi doc MQTT theo ACL mau.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=health_edge
MQTT_PASSWORD=replace_with_local_edge_password
MQTT_ENABLED=true

# Simulator/firmware: dung tai khoan node rieng, khong dung tai khoan edge.
SIMULATOR_MQTT_USERNAME=health_node
SIMULATOR_MQTT_PASSWORD=replace_with_local_node_password
DEVICE_ID=health-node-01

# Duong dan du lieu local; sqlite3 la mot phan cua Python.
EDGE_DATABASE_PATH=./data/health-edge.db

# Edge API. Docker profile `full` ghi de host thanh 0.0.0.0 ben trong
# container, nhung chi publish dashboard ra 127.0.0.1 tren laptop.
EDGE_ALLOWED_HOSTS=127.0.0.1,localhost,edge
EDGE_QUEUE_SIZE=1000
DEVICE_OFFLINE_AFTER_SECONDS=15
EDGE_MAX_PAYLOAD_BYTES=4096
EDGE_TELEMETRY_RETENTION_ROWS=50000
DEMO_MAX_SAMPLE_GAP_SECONDS=3

# Telegram tuy chon: tat mac dinh. Chi dien token/chat ID trong tep .env cuc bo.
# Nguoi nhan phai nhan Start hoac gui mot tin cho bot truoc lan gui dau tien.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=5
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_RETRY_BASE_SECONDS=1
TELEGRAM_RETRY_MAX_SECONDS=30
TELEGRAM_QUEUE_SIZE=100
TELEGRAM_SHUTDOWN_TIMEOUT_SECONDS=6
