# Generated by deploy/scripts/Initialize-Mosquitto.ps1.
# The edge account may consume all health-node messages.
user __EDGE_USERNAME__
topic read iot-health/v1/devices/+/telemetry
topic read iot-health/v1/devices/+/event
topic read iot-health/v1/devices/+/status

# The device/simulator account may publish only for its configured device ID.
user __DEVICE_USERNAME__
topic write iot-health/v1/devices/__DEVICE_ID__/telemetry
topic write iot-health/v1/devices/__DEVICE_ID__/event
topic write iot-health/v1/devices/__DEVICE_ID__/status
